#!/usr/bin/env bash
# agent-grant — time-boxed window where the Claude agent may run READ-ONLY git
# and downloads (git clone/fetch, wget, curl). Enforced by claude/hooks/git-gate.sh,
# surfaced in the Claude statusline and the reinforce hook. Flag = expiry epoch in
# ~/.claude/.agent-grant (runtime state, never tracked). tmux: prefix g toggles.
#
#   agent-grant [minutes]   open (or extend) a window — default 15
#   agent-grant off         revoke now
#   agent-grant status      remaining time; exit 1 if closed
#   agent-grant toggle      keybind helper: closed → open 15m · open → revoke

set -euo pipefail
FLAG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.agent-grant"
# humpty's gate (PreToolUse, installed 2026-07-28) holds its OWN window file; both
# gates are deny-first, so this window is dead unless humpty's opens too. One
# keypress must open both — write its flag in lockstep. Format: pipeline=epoch lines.
HFLAG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.humpty-grant"

now() { date +%s; }

active() {
  [ -f "$FLAG" ] || return 1
  exp=$(head -n1 "$FLAG" 2>/dev/null | tr -d '[:space:]')
  case "$exp" in ''|*[!0-9]*) rm -f "$FLAG"; return 1 ;; esac
  [ "$(now)" -lt "$exp" ] || { rm -f "$FLAG"; return 1; }
}

open_win() {
  min="${1:-15}"
  case "$min" in ''|*[!0-9]*) echo "agent-grant: bad minutes '$min'" >&2; exit 2 ;; esac
  exp=$(( $(now) + min * 60 ))
  printf '%s\n' "$exp" > "$FLAG"
  printf 'git=%s\ndownloads=%s\n' "$exp" "$exp" > "$HFLAG"
  echo "agent grant ON — git-read + download for ${min}m (both gates)"
}

close_win() { rm -f "$FLAG" "$HFLAG"; echo "agent grant OFF"; }

case "${1:-}" in
  off)    close_win ;;
  status) if active; then echo "agent grant ON — $(( (exp - $(now) + 59) / 60 ))m left"; else echo "agent grant OFF"; exit 1; fi ;;
  toggle) if active; then close_win; else open_win 15; fi ;;
  *)      open_win "${1:-15}" ;;
esac
